#!/usr/bin/env sh
# pre-push --- refuse to push anything that carries a private name.
#
# commit-msg and pre-commit check a commit when it is made, but several ordinary operations
# make commits without running either hook: `git am`, `git cherry-pick`, `git rebase`, and any
# commit made with --no-verify. So this hook checks what is about to leave the machine,
# however it was made: every commit being pushed (its message, the lines it adds and the paths
# it adds or renames), the names of the branches and tags being pushed, and the message of an
# annotated tag. It is the one check a commit cannot skip on its way into the public
# repository.
#
# What counts as a name, where the list comes from, and why a refusal never prints the
# matching text: .githooks/private-names.sh.

set -eu

. "$(dirname "$0")/private-names.sh"

pn_load || exit 1
[ -n "$PN_PATTERN" ] || exit 0

remote=$1

# The all-zero object id git uses for "no object", as long as this repository's ids are.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

findings=

while read -r local_ref local_oid remote_ref remote_oid; do
  # Deleting a remote branch carries no content.
  [ "$local_oid" = "$zero" ] && continue

  if printf '%s\n%s\n' "$local_ref" "$remote_ref" | grep -qiE "$PN_PATTERN"; then
    findings="${findings}      the name of a branch or tag being pushed
"
  fi

  if [ "$(git cat-file -t "$local_oid")" = tag ] \
     && git cat-file -p "$local_oid" | grep -qiE "$PN_PATTERN"; then
    findings="${findings}      the message of a tag being pushed
"
  fi

  # The commits this push would give the remote. A new branch has no remote object id, so it
  # is every commit not already on one of this remote's branches.
  if [ "$remote_oid" = "$zero" ]; then
    commits=$(git rev-list "$local_oid" --not --remotes="$remote")
  else
    commits=$(git rev-list "$remote_oid..$local_oid")
  fi

  for c in $commits; do
    short=$(git rev-parse --short "$c")
    msg_lines=$(git log -1 --format=%B "$c" | grep -inE "$PN_PATTERN" | cut -d: -f1 | paste -sd, - || true)
    if [ -n "$msg_lines" ]; then
      findings="${findings}      commit $short: line $msg_lines of its message
"
    fi
    paths=$(git diff-tree --no-commit-id --name-only -r --root -m --first-parent --diff-filter=ACMR "$c" \
              | grep -iE "$PN_PATTERN" || true)
    if [ -n "$paths" ]; then
      findings="${findings}      commit $short: $(printf '%s\n' "$paths" | wc -l | tr -d ' ') file path(s) it adds or renames (list them with: git show --name-only $short)
"
    fi
    lines=$(git diff-tree -p --no-commit-id --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ -U0 \
              -r --root -m --first-parent --diff-filter=ACMR "$c" | pn_hits_in_diff "$paths")
    if [ -n "$lines" ]; then
      findings="${findings}$(printf '%s\n' "$lines" | sed "s/^/      commit $short: /")
"
    fi
  done
done

[ -z "$findings" ] && exit 0

pn_refuse_intro "a private name appears in what you are about to push."
printf '  Found in:\n\n%s\n' "$findings" >&2
cat >&2 <<'MSG'
  Nothing was pushed. To change a commit that has already been made, amend it, or rebase and
  reword or edit the commits listed above.

MSG
pn_advice
exit 1
