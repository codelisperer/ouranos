;;;; source-registry.lisp --- bootstrap's ASDF drop-in, and when it refuses to change it (#955)
;;;;
;;;; scripts/source-registry.lisp decides what bootstrap.lisp does with 50-ouranos.conf, the
;;;; drop-in every process run by this user reads. The tests run the decision on its own, then
;;;; the whole step against a drop-in in a fresh directory, then bootstrap.lisp itself in a
;;;; child sbcl with XDG_CONFIG_HOME pointing at a fresh directory, so no test reads or writes
;;;; this machine's real drop-in.
;;;;
;;;; The refusal tests compare the drop-in byte for byte before and after, because the defect
;;;; was that the file changed and nothing said so.

(in-package #:checkers/tests)

;;; FiveAM's current suite does not carry over from one file to the next (see dump-image.lisp).
(in-suite checkers)

;;; At compile time too: the tests below name the package it defines.
(eval-when (:compile-toplevel :load-toplevel :execute)
  (load (merge-pathnames "source-registry.lisp" *scripts*)))

(defun %drop-in-in (dir)
  "Where a drop-in goes under DIR, used as XDG_CONFIG_HOME."
  (merge-pathnames "common-lisp/source-registry.conf.d/50-ouranos.conf" dir))

(defun %drop-in-naming (conf tree)
  "Write CONF as bootstrap writes it, naming TREE (a pathname or a string)."
  (%write conf (format nil ";;;; Generated by ouranos/bootstrap.lisp -- machine-local, do not commit.~%(:tree \"~A\")~%"
                       (substitute #\/ #\\ (if (pathnamep tree) (namestring tree) tree)))))

(defun %file-octets (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((octets (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (subseq octets 0 (read-sequence octets in)))))

(defun %step (root conf &rest env)
  "Run REGISTRY-STEP for ROOT against CONF with an environment holding only ENV (alternating
names and values). Returns (values action output), or (values :refused message) when it
refuses."
  (let ((out (make-string-output-stream)))
    (handler-case
        (values (ouranos-registry:registry-step
                 root :conf conf :stream out
                      :getenv (lambda (var)
                                (loop for (name value) on env by #'cddr
                                      when (string= name var) return value)))
                (get-output-stream-string out))
      (ouranos-registry:registry-refused (e)
        (values :refused (princ-to-string e))))))

(test registry-action-decides-each-case-without-reading-anything
  (is (eq :write (ouranos-registry:registry-action :none)))
  (is (eq :rewrite (ouranos-registry:registry-action :same)))
  (is (eq :rewrite (ouranos-registry:registry-action :missing)))
  (is (eq :refuse (ouranos-registry:registry-action :other)))
  (is (eq :refuse (ouranos-registry:registry-action :unreadable)))
  (is (eq :repoint (ouranos-registry:registry-action :other :force t)))
  (is (eq :repoint (ouranos-registry:registry-action :unreadable :force t)))
  (is (eq :write (ouranos-registry:registry-action :none :force t)) "FORCE changes nothing when there is nothing to repoint")
  (is (eq :local (ouranos-registry:registry-action :other :local t)))
  (is (eq :local (ouranos-registry:registry-action nil :local t :force t)) "LOCAL wins over FORCE: the drop-in is not touched"))

(test classify-drop-in-names-what-the-drop-in-says-about-this-tree
  (let* ((root (%fresh-tree))
         (this (%new-directory root "this-"))
         (other (%new-directory root "other-"))
         (conf (%drop-in-in (%new-directory root "xdg-"))))
    (is (eq :none (ouranos-registry:classify-drop-in conf this)))
    (%drop-in-naming conf this)
    (is (eq :same (ouranos-registry:classify-drop-in conf this)))
    (%drop-in-naming conf other)
    (multiple-value-bind (kind named) (ouranos-registry:classify-drop-in conf this)
      (is (eq :other kind))
      (is (equal (substitute #\/ #\\ (namestring other)) named) "the tree is returned as the drop-in writes it"))
    (%drop-in-naming conf (merge-pathnames "gone/" root))
    (is (eq :missing (ouranos-registry:classify-drop-in conf this)))
    (%write conf "(:tree \"/a/\") (:tree \"/b/\")")
    (is (eq :unreadable (ouranos-registry:classify-drop-in conf this)) "two forms")
    (%write conf "(:directory \"/a/\")")
    (is (eq :unreadable (ouranos-registry:classify-drop-in conf this)) "another directive")
    (%write conf "(:tree #.(error \"read-eval ran\"))")
    (is (eq :unreadable (ouranos-registry:classify-drop-in conf this)) "#. is not evaluated")
    (%write conf "(:tree \"/a/\"")
    (is (eq :unreadable (ouranos-registry:classify-drop-in conf this)) "an unfinished form")))

(test a-drop-in-naming-this-tree-through-a-symbolic-link-is-this-tree
  (if (uiop:os-windows-p)
      (skip "creating a symbolic link needs a privilege a Windows runner does not grant by default")
      (let* ((root (%fresh-tree))
             (this (%new-directory root "this-"))
             (link (merge-pathnames "link-to-this" root))
             (conf (%drop-in-in (%new-directory root "xdg-"))))
        (uiop:run-program (list "ln" "-s" (uiop:native-namestring (string-right-trim "/" (namestring this)))
                                (uiop:native-namestring link)))
        (%drop-in-naming conf (concatenate 'string (uiop:native-namestring link) "/"))
        (is (eq :same (ouranos-registry:classify-drop-in conf this))))))

(test registry-step-writes-rewrites-and-repoints-the-drop-in
  (let* ((root (%fresh-tree))
         (this (%new-directory root "this-"))
         (other (%new-directory root "other-"))
         (conf (%drop-in-in (%new-directory root "xdg-")))
         (named (format nil "(:tree \"~A\")" (substitute #\/ #\\ (namestring this)))))
    (is (eq :write (%step this conf)))
    (is (search named (uiop:read-file-string conf)) "a new drop-in names this tree")
    (is (eq :rewrite (%step this conf)) "a second run in the same tree")
    (%drop-in-naming conf (merge-pathnames "gone/" root))
    (multiple-value-bind (action out) (%step this conf)
      (is (eq :rewrite action))
      (is (search "which no longer exists" out) "~A" out)
      (is (search named (uiop:read-file-string conf))))
    (%drop-in-naming conf other)
    (multiple-value-bind (action out) (%step this conf "OURANOS_BOOTSTRAP_FORCE" "1")
      (is (eq :repoint action))
      (is (search "OURANOS_BOOTSTRAP_FORCE is set" out) "~A" out)
      (is (search named (uiop:read-file-string conf))))))

(test registry-step-refuses-to-change-a-drop-in-naming-another-tree
  (let* ((root (%fresh-tree))
         (this (%new-directory root "this-"))
         (other (%new-directory root "other-"))
         (conf (%drop-in-in (%new-directory root "xdg-"))))
    (%drop-in-naming conf other)
    (let ((before (%file-octets conf)))
      (multiple-value-bind (action message) (%step this conf)
        (is (eq :refused action) "the step returned ~S" action)
        (is (equalp before (%file-octets conf)) "the drop-in changed")
        (is (search (uiop:native-namestring other) message) "the other tree is not named:~%~A" message)
        (is (search (uiop:native-namestring this) message) "this tree is not named:~%~A" message)
        (is (search "OURANOS_BOOTSTRAP_LOCAL" message))
        (is (search "OURANOS_BOOTSTRAP_FORCE" message))
        (is (search (ouranos-registry:local-registry-value this) message)
            "the CL_SOURCE_REGISTRY value to set is not printed:~%~A" message)))
    (%write conf "(:directory \"/hand/edited/\")")
    (let ((before (%file-octets conf)))
      (multiple-value-bind (action message) (%step this conf)
        (is (eq :refused action) "an unreadable drop-in: the step returned ~S" action)
        (is (equalp before (%file-octets conf)) "the unreadable drop-in changed")
        (is (search "is not a single (:tree" message) "~A" message)))))

(test the-refusal-prints-each-command-for-the-shell-of-its-os
  (let ((posix (format nil "~{~A~%~}" (ouranos-registry:refusal-commands #p"/w/tree/" :windows nil)))
        (windows (format nil "~{~A~%~}" (ouranos-registry:refusal-commands #p"/w/tree/" :windows t))))
    (is (search "OURANOS_BOOTSTRAP_LOCAL=1 sbcl --dynamic-space-size 4096 --script bootstrap.lisp" posix))
    (is (search "OURANOS_BOOTSTRAP_FORCE=1 sbcl" posix))
    (is (search "export CL_SOURCE_REGISTRY='" posix))
    (is (search "//:'" posix) "the POSIX separator is :")
    (is (search "$env:OURANOS_BOOTSTRAP_LOCAL='1'; sbcl" windows))
    (is (search "$env:OURANOS_BOOTSTRAP_FORCE='1'; sbcl" windows))
    (is (search "$env:CL_SOURCE_REGISTRY='" windows))
    (is (search "//;'" windows) "the Windows separator is ;")))

(test tree-local-mode-leaves-the-drop-in-alone-and-hands-its-registry-to-children
  (let* ((root (%fresh-tree))
         (this (%new-directory root "this-"))
         (other (%new-directory root "other-"))
         (conf (%drop-in-in (%new-directory root "xdg-")))
         (saved (uiop:getenv "CL_SOURCE_REGISTRY"))
         (value (ouranos-registry:local-registry-value this)))
    (unwind-protect
         (progn
           (is (eq :local (%step this conf "OURANOS_BOOTSTRAP_LOCAL" "1")))
           (is (not (probe-file conf)) "local mode wrote a drop-in")
           (%drop-in-naming conf other)
           (let ((before (%file-octets conf)))
             (multiple-value-bind (action out) (%step this conf "OURANOS_BOOTSTRAP_LOCAL" "1")
               (is (eq :local action))
               (is (equalp before (%file-octets conf)) "local mode changed the drop-in")
               (is (search value out) "the value is not printed:~%~A" out)))
           (is (equal value (uiop:getenv "CL_SOURCE_REGISTRY")))
           (is (uiop:string-prefix-p (string-right-trim "/\\" (uiop:native-namestring this)) value))
           ;; The warm step and the platform package run in children started with this
           ;; process's environment, so the value must reach a child started the same way.
           (let ((seen (uiop:run-program
                        (list (namestring sb-ext:*runtime-pathname*) "--noinform" "--non-interactive"
                              "--no-sysinit" "--no-userinit"
                              "--eval" "(progn (write-string (or (sb-ext:posix-getenv \"CL_SOURCE_REGISTRY\") \"<unset>\")) (terpri))")
                        :output '(:string :stripped t))))
             (is (equal value seen) "a child saw ~S" seen)))
      (if saved
          (setf (uiop:getenv "CL_SOURCE_REGISTRY") saved)
          (uiop:symbol-call :sb-posix :unsetenv "CL_SOURCE_REGISTRY")))))

(defun %bootstrap-fixture ()
  "A fresh tree holding bootstrap.lisp and only the scripts it loads before the drop-in step.
If the step does not stop the run, bootstrap fails on the next missing script, here, instead
of building in this tree."
  (let ((tree (%fresh-tree)))
    (uiop:copy-file (merge-pathnames "bootstrap.lisp" td-root) (merge-pathnames "bootstrap.lisp" tree))
    (ensure-directories-exist (merge-pathnames "scripts/" tree))
    (dolist (name '("human-path.lisp" "heap-guard.lisp" "source-registry.lisp"))
      (uiop:copy-file (merge-pathnames name *scripts*) (merge-pathnames name (merge-pathnames "scripts/" tree))))
    tree))

(test bootstrap-stops-with-exit-3-and-leaves-a-drop-in-naming-another-tree-unchanged
  (let* ((tree (%bootstrap-fixture))
         (other (%fresh-tree))
         (xdg (%fresh-tree))
         (conf (%drop-in-in xdg)))
    (%drop-in-naming conf other)
    (let ((before (%file-octets conf))
          (out (make-string-output-stream)))
      (let ((code (nth-value 2 (uiop:run-program
                                (list (namestring sb-ext:*runtime-pathname*)
                                      "--dynamic-space-size" "4096"
                                      "--script" (namestring (merge-pathnames "bootstrap.lisp" tree)))
                                :output out :error-output out :ignore-error-status t
                                :environment
                                (cons (format nil "XDG_CONFIG_HOME=~A" (uiop:native-namestring xdg))
                                      (remove-if (lambda (e)
                                                   (some (lambda (name) (uiop:string-prefix-p name e))
                                                         '("XDG_CONFIG_HOME=" "OURANOS_BOOTSTRAP_LOCAL="
                                                           "OURANOS_BOOTSTRAP_FORCE=")))
                                                 (sb-ext:posix-environ))))))
            (text (get-output-stream-string out)))
        (is (eql 3 code) "bootstrap exited ~A:~%~A" code text)
        (is (equalp before (%file-octets conf)) "bootstrap changed the drop-in")
        (is (search (uiop:native-namestring other) text) "the other tree is not named:~%~A" text)
        ;; The truename: bootstrap finds its tree from its own *LOAD-TRUENAME*, and on macOS the
        ;; temporary directory is reached through a symbolic link.
        (is (search (uiop:native-namestring (truename tree)) text) "this tree is not named:~%~A" text)))))
