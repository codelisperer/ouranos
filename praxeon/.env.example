# Praxeon LLM configuration.
#
# Copy to .env (which is git-ignored) and fill in your values. Praxeon reads
# these from the environment; `praxeon/config:load-dotenv` loads this file into
# the environment so you don't have to export them in your shell profile.
# See src/llm.lisp for the provider-selection factory.

# Which provider implementation to use. Selects the PROVIDER class:
#   anthropic   -> Anthropic Messages API (needs API credits; see note below)
#   openai      -> any OpenAI-compatible /v1 endpoint (set PRAXEON_LLM_BASE_URL)
#   ollama      -> local Ollama            (defaults base URL to localhost:11434/v1)
#   openrouter  -> OpenRouter              (defaults base URL to openrouter.ai/api/v1)
PRAXEON_LLM_IMPL=anthropic

# Base URL for the openai/openai-compatible impls. Ignored by anthropic. The
# ollama/openrouter impls fill in a sensible default when this is unset.
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   OpenRouter: https://openrouter.ai/api/v1
# PRAXEON_LLM_BASE_URL=http://localhost:11434/v1

# --- Per-provider overrides (optional) -------------------------------------
# Any var above can be set per provider with a PRAXEON_<IMPL>_ prefix, which
# wins over the shared PRAXEON_LLM_ version. Keep both providers configured and
# switch by changing ONE line (PRAXEON_LLM_IMPL). Impls: ANTHROPIC, OPENAI,
# OLLAMA, OPENROUTER.
#
#   PRAXEON_ANTHROPIC_API_KEY=sk-ant-...
#   PRAXEON_ANTHROPIC_MODEL=claude-sonnet-5
#   PRAXEON_OPENROUTER_API_KEY=sk-or-...
#   PRAXEON_OPENROUTER_MODEL=openai/gpt-4o-mini
#   # then flip only this:
#   PRAXEON_LLM_IMPL=anthropic        # <-> openrouter

# Vendor model id (interpreted by the chosen impl). Opus 4.8 is the recommended
# default for Praxeon's agentic tool-use loops; claude-sonnet-5 is the cheaper
# near-Opus alternative.
PRAXEON_OPENROUTER_MODEL=openai/gpt-4o-mini
PRAXEON_ANTHROPIC_MODEL=claude-opus-4-8

# Authentication: the Anthropic impl sends PRAXEON_LLM_API_KEY as x-api-key.
# NOTE: the raw Messages API bills *API credits* -- an Anthropic subscription
# (Pro/Max) funds Claude.ai / Claude Code, not /v1/messages, so there is no
# subscription-billed path. You need a positive API credit balance for live calls.

# API key (Anthropic x-api-key / OpenAI Bearer). NEVER commit a real key
# (.env is git-ignored; this .example file must keep the placeholder).
PRAXEON_OPENROUTER_API_KEY="sk-or-REPLACE-ME-WITH-YOUR-REAL-KEY"
PRAXEON_ANTHROPIC_API_KEY="sk-ant-REPLACE-ME-WITH-YOUR-REAL-KEY"

# Tavily API key for integrating web search into your agents. If you don't have one, 
# leave this blank and your agents will not be able to search the web.
TAVILY_API_KEY="sk-tavily-REPLACE-ME-WITH-YOUR-REAL-KEY"
TAVILY_MCP_LINK="https://mcp.tavily.com/mcp/?tavilyApiKey=sk-tavily-REPLACE-ME-WITH-YOUR-REAL-KEY"