# The libgit2 release this tree builds `aion/libgit` against (#429).
#
# Same doctrine as libuv.pin and mbedtls.pin: the REPO declares the version, so adopting a new
# one is an ordinary commit that propagates through git, and the library is FETCHED AND BUILT
# FROM SOURCE by
#   sbcl --script scripts/build-libgit2.lisp
# with a C compiler alone: no cmake, no make. A native dependency we do not build is one we
# cannot bundle (ADR-0011).
#
# `aion/libgit` is an OPT-IN system. Nothing that merely uses aion loads libgit2; an app that
# keeps no versioned history never carries it.
#
# The maintainer approved this dependency on #429 (comment 5916493345): libgit2 v1.9.7, built
# without cmake, HTTPS through the platform (SecureTransport on macOS, WinHTTP on Windows,
# OpenSSL loaded at run time on Linux), and bundles that carry the binary ship this tarball and
# its licence beside it: SOURCES/ and LICENSES/, put there by scripts/build-desktop-app.lisp and
# checked by scripts/check-bundle-sources.lisp (ADR-0013's amendment of 2026-10-01).

version 1.9.7
sha256  1a4fbe7589e814777ae76b64734ad80f4ecad22cd33a22682a2aaea4ae5375e7
url     https://github.com/libgit2/libgit2/archive/refs/tags/v1.9.7.tar.gz

# The licence: GPL version 2 with the libgit2 linking exception (COPYING in the tarball). The
# exception allows linking the library from a program under any licence; the library itself
# stays GPLv2, so a bundle that carries the binary also carries its source (the tarball above)
# and COPYING. build-libgit2.lisp copies COPYING beside the built library, where the bundler
# picks up licence texts.
licence GPL-2.0 with the libgit2 linking exception

# On the checksum. Recorded trust-on-first-use on 2026-09-30: fetched over TLS from GitHub's
# archive of the v1.9.7 tag and hashed here. libgit2 publishes no release asset, only the tag;
# GitHub keeps tag archives byte-stable. Every later fetch is verified against this line.

# THE CANDIDATE SOURCE SET: every .c file the build could compile, on any platform. That is
# src/util (all of it, with its unix/, win32/, allocators/ and hash/ trees), src/libgit2 with
# streams/ and transports/, and deps/zlib, deps/llhttp, deps/pcre2 and deps/xdiff. The count
# and the sha256 of their tarball-relative paths, sorted, one per line, each ending in a
# newline. build-libgit2.lisp refuses a tree whose set differs, so a new version that adds,
# moves or drops a file fails loudly instead of building something nobody reviewed.
sources-count  234
sources-digest baa8f340c5ac254627dae52c3d9ac5e93d8fd84faacb245dac64ab11c560fdfd

# To adopt a new libgit2:
#   1. curl -sSLO https://github.com/libgit2/libgit2/archive/refs/tags/vX.Y.Z.tar.gz
#   2. shasum -a 256, and update version, sha256 and url above;
#   3. run build-libgit2.lisp: it prints the new source count and digest when they differ.
#      Read what changed before updating them, and compare each platform's features header in
#      the script with the new src/util/git2_features.h.in, whose names do change;
#   4. delete vendor/libgit2/, rebuild, and run the aion/libgit suite on all three OSes.

# --- staying current ---------------------------------------------------------
#
# REVIEWED is the date a human last read the advisories page. It is the only thing that
# distinguishes "no advisory affects us" from "nobody has looked".

# Reviewed on 2026-09-30: all eleven advisories on that page. v1.9.7 is past every one with a
# fix. Two list no patched version, and the 2026-09-30 review took that to mean no fix
# existed. That was wrong: on 2026-10-12 (#623's review) they were found to be CVE-2026-53586
# and CVE-2026-53583, and v1.9.5's entry in docs/changelog.md fixes both. Both concern only
# fetching from and pushing to a remote over HTTPS. This pin is 1.9.7. What aion/libgit's
# fetch, pull and push do about them (aion/src/libgit/remote.lisp), as the maintainer settled
# on #429 (comments 6126647317 and 6129212845):
#   GHSA-2889-x8f6-mc4x  CVE-2026-53586. The HTTP transport follows an offsite redirect on
#                        its first request, and before v1.9.5 it asked the credentials callback
#                        with the original remote's URL. v1.9.5 passes the redirected URL, but
#                        still follows the redirect by default, so a caller that passes one
#                        fixed credential still sends it to the new host. aion/libgit sets
#                        follow_redirects to GIT_REMOTE_REDIRECT_NONE unless the caller asks
#                        otherwise, and a test checks that an offsite redirect is refused.
#   GHSA-h7gc-w2gg-p9xp  CVE-2026-53583. The OpenSSL stream compared a certificate's IP
#                        addresses the wrong way round. v1.9.5 fixed it: 1.9.7's
#                        src/libgit2/streams/openssl.c compares with memcmp(...) == 0.
#                        aion/libgit does nothing about it. #623 first refused an https remote
#                        whose host is an IP literal on Linux, and removed that refusal once
#                        the fix was found.
# Re-check both whenever this pin moves, and update the date.

advisories https://github.com/libgit2/libgit2/security/advisories
reviewed   2026-09-30
