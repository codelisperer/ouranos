# hermes/.env.example --- copy to `.env` (gitignored) and fill in.
#
# These load into the process environment via cons/env:load-dotenv; the host
# environment wins in prod (set real vars there, ship no .env).

# --- transport selection -----------------------------------------------------
# HERMES_TRANSPORT=dev forces the dev/log transport for every channel (renders to
# the console instead of sending) -- the local-dev default. Leave unset in prod.
# HERMES_TRANSPORT=dev

# Per-channel provider (used when HERMES_TRANSPORT is unset):
# HERMES_EMAIL_IMPL=sendgrid      # or "dev"
# HERMES_SMS_IMPL=twilio          # or "dev"
# HERMES_TELEGRAM_IMPL=telegram   # or "dev"
# HERMES_FACEBOOK_IMPL=facebook   # or "dev"

# --- SendGrid (email) --------------------------------------------------------
# SENDGRID_API_KEY=REPLACE_ME

# --- Twilio (SMS, outbound + inbound) ----------------------------------------
# TWILIO_ACCOUNT_SID=REPLACE_ME
# TWILIO_AUTH_TOKEN=REPLACE_ME    # also verifies inbound webhook signatures
# TWILIO_FROM=+15551234567        # default outbound sender (E.164)

# --- Telegram (groups and channels) ------------------------------------------
# The bot's token from @BotFather. It is replaced by <redacted> in failure text, since
# Telegram puts it in the URL path.
# TELEGRAM_BOT_TOKEN=REPLACE_ME

# --- Facebook Pages ------------------------------------------------------------
# The Meta app's id and secret, for the connect flow and the health check. The secret is
# used only on the server, and is replaced by <redacted> in failure text.
# FACEBOOK_APP_ID=REPLACE_ME
# FACEBOOK_APP_SECRET=REPLACE_ME
# A connected Page's token, one per Page id (or FACEBOOK_PAGE_TOKEN for one Page).
# FACEBOOK_PAGE_TOKEN_1234567890=REPLACE_ME

# --- Payments (hermes/payments) ----------------------------------------------
# Which payment backend to use. HERMES_TRANSPORT=dev forces the in-memory dev provider
# for payments too, so a local run reaches no vendor and charges nobody -- which is the
# point: a module whose local-dev path reaches a real vendor is one that gets tested
# against real money.
# HERMES_PAYMENTS_IMPL=stripe
#
# Use a RESTRICTED key, never a full-access one. Card data never reaches our servers --
# checkout is hosted, and no operation in the protocol accepts a card number -- which is
# what keeps PCI scope at SAQ-A.
# STRIPE_SECRET_KEY=REPLACE_ME
# STRIPE_WEBHOOK_SECRET=REPLACE_ME   # verifies inbound webhook signatures (HMAC-SHA256)
